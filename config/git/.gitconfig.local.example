# Copy this file to ~/.gitconfig.local for machine- or client-specific Git settings.

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

# Client-specific hosts belong here too.
