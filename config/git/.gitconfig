[user]
  name = Logan Farci
  email = farci.logan@gmail.com

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore_global

[alias]
  co = checkout
  br = branch
  st = status -sb
  lg = log --oneline --graph --decorate --all
  rb = rebase
  undo = reset --soft HEAD~1

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Included last so machine-specific identity and authentication settings win.
[include]
  path = ~/.gitconfig.local
